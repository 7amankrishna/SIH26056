# Keep the deployment lean and never upload secrets/dev artifacts.
node_modules/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
frontend/.vite/
frontend/node_modules/
tests/
*.csv
*.parquet
.env
.env.*
.git
.gitignore

# …but the user's own data files ARE part of the deployment: they are what the
# dashboard serves. Re-include them after the *.csv rule above.
!data/**
