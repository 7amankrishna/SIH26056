# APIx environment — copy to `.env` and fill in. `.env` is git-ignored.
#
# ── Supabase (PostgreSQL) ─────────────────────────────────────────────────────
# The collection store targets Supabase. Grab the connection string from:
#   Supabase dashboard → your project → Project Settings → Database → Connection string.
# Use the *Session pooler* or *Direct connection* string (port 5432), or the
# Transaction pooler (port 6543) with ?sslmode=require:
#
#   DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Never set to 1 when you want scraped data to persist to Supabase.
APIX_IGNORE_DATABASE_URL=0

# ── Collection engine (the scraper) ──────────────────────────────────────────
# Which sources are registered. Add the OTA browser scrapers:
APIX_COLLECTOR_SOURCES=ota_cleartrip,ota_easemytrip
# Run the background sweep loop (1) instead of in-request sweeps (0).
APIX_COLLECTOR_ENABLED=1
# 0 = serve scraped/live data; 1 = deterministic synthetic demo.
APIX_DEMO_MODE=0
# Pin the dashboard to live scraped data (leave empty to keep the toggle).
APIX_DATA_MODE=live

# ── OTA browser scrapers ─────────────────────────────────────────────────────
# Headless by default (required in Docker/CI). Set 0 to watch the browser.
APIX_OTA_HEADLESS=1
APIX_OTA_TIMEOUT_MS=60000
# Advance-purchase windows each sweep collects (T+1, T+7, T+30 days).
APIX_SWEEP_LEAD_TIMES=1,7,30

# ── Politeness / limits ──────────────────────────────────────────────────────
APIX_MIN_REQUEST_GAP_SECONDS=2.0
APIX_MAX_REQUESTS_PER_SWEEP=120
